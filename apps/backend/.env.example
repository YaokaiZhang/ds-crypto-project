# Server-only configuration. Blank values do not enable integrations.
DATABASE_URL=
ETHEREUM_RPC_URL=
ETHERSCAN_API_KEY=
# Optional backend-local input indexes; defaults are in apps/backend/config/.
# Paths inside an index are relative to the index file.
MODEL_REGISTRY_PATH=
TOKEN_MODEL_REGISTRY_PATH=
# Shared across all Etherscan users/workers; retries count, RPC does not.
ETHERSCAN_RATE_LIMIT=3
ETHERSCAN_DAILY_LIMIT=99000
# Calendar day resets at UTC 00:00. Use the same account ledger in every process.
# Default: repository .runtime/etherscan/quota.sqlite3
ETHERSCAN_QUOTA_FILE=
# Analysis scoring mode; configure the same values for API and worker.
ANALYSIS_MODE=template
# Real remote inference: ANALYSIS_MODE=eth_live
# HTTPS base URL; do not append /predict.
INFERENCE_URL=
# Same application key as the Modal Secret, not your Modal management token.
INFERENCE_API_KEY=
INFERENCE_TIMEOUT=180
ANALYSIS_DATABASE_PATH=
ANALYSIS_ARTIFACT_PATH=
ANALYSIS_CONCURRENCY=2
# Real homepage RPC feed; independent of ANALYSIS_MODE. Start the separate worker.
FEED_ENABLED=false
# ETHEREUM_RPC_URL above defaults to https://ethereum-rpc.publicnode.com when blank.
# API and worker must use the same local SQLite path; defaults to the OS temp dir.
FEED_DATABASE_PATH=
